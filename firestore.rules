rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile Rules: Only user themselves can read/write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Routes Rules: 
    // - Read allowed if route is public OR if the user owns the route
    // - Create allowed if authenticated and userId matches request auth
    // - Update/Delete allowed only if user owns the route
    match /routes/{routeId} {
      allow read: if resource.data.isPublic == true || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
